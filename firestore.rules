rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isCEO() {
      return isSignedIn() && request.auth.token.email == 'eymosuruk@gmail.com';
    }
    
    function isAdmin() {
      return isSignedIn() && (isCEO() || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Specific Validators ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'createdAt']) &&
             data.keys().size() <= 10 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.role in ['admin', 'user'] &&
             data.createdAt == request.time;
    }

    function isValidNews(data) {
      return data.keys().hasAll(['title', 'content', 'authorId', 'authorName', 'category', 'createdAt']) &&
             data.keys().size() <= 10 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 10000 &&
             data.authorId == request.auth.uid &&
             data.authorName is string &&
             data.category is string &&
             data.createdAt == request.time;
    }

    function isValidForumPost(data) {
      return data.keys().hasAll(['title', 'content', 'authorId', 'authorName', 'category', 'createdAt', 'commentCount']) &&
             data.keys().size() <= 10 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 5000 &&
             data.authorId == request.auth.uid &&
             data.authorName is string &&
             data.category is string &&
             data.commentCount is number &&
             data.createdAt == request.time;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['postId', 'authorId', 'authorName', 'content', 'createdAt']) &&
             data.keys().size() <= 10 &&
             data.postId is string &&
             data.authorId == request.auth.uid &&
             data.authorName is string &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 1000 &&
             data.createdAt == request.time;
    }

    // --- Match Rules ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatarUrl']) &&
                      incoming().name is string && incoming().name.size() <= 100;
    }

    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isCEO();
    }

    match /news/{articleId} {
      allow read: if true;
      allow create: if isAdmin() && isValidNews(incoming());
      allow update: if isAdmin() && isValidNews(incoming());
      allow delete: if isAdmin();
    }

    match /forum_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidForumPost(incoming());
      allow update: if isOwner(existing().authorId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'category']) &&
                      incoming().title is string && incoming().title.size() <= 200;
      allow delete: if isOwner(existing().authorId) || isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidComment(incoming());
        allow delete: if isOwner(existing().authorId) || isAdmin();
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false; 
    }
  }
}
