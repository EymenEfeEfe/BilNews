rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Specific Validators ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'createdAt']) &&
             data.keys().size() <= 6 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.role in ['admin', 'user'] &&
             data.createdAt == request.time;
    }

    function isValidPost(data) {
      return data.keys().hasAll(['title', 'content', 'type', 'authorId', 'authorName', 'categoryId', 'createdAt', 'likesCount', 'commentsCount']) &&
             data.keys().size() <= 10 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 5000 &&
             data.type in ['news', 'forum'] &&
             data.authorId == request.auth.uid &&
             data.authorName is string &&
             data.categoryId is string &&
             data.likesCount is number &&
             data.commentsCount is number &&
             data.createdAt == request.time;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['postId', 'authorId', 'authorName', 'content', 'createdAt']) &&
             data.keys().size() <= 5 &&
             data.postId is string &&
             data.authorId == request.auth.uid &&
             data.authorName is string &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 1000 &&
             data.createdAt == request.time;
    }

    // --- Match Rules ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatarUrl']) &&
                      incoming().name is string && incoming().name.size() <= 100;
    }

    match /posts/{postId} {
      allow list: if true; // Public listings allowed, enforced by schema
      allow get: if true;
      allow create: if isSignedIn() && isValidPost(incoming());
      allow update: if (
        // Option 1: Owner updates content
        (isOwner(existing().authorId) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'categoryId', 'updatedAt']) &&
         incoming().title is string && incoming().title.size() <= 200 &&
         incoming().updatedAt == request.time) ||
        // Option 2: System/User increments likes/comments
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount']))
      );
      allow delete: if isOwner(existing().authorId);

      match /comments/{commentId} {
        allow list: if true;
        allow get: if true;
        allow create: if isSignedIn() && isValidComment(incoming());
        allow delete: if isOwner(existing().authorId);
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false; // Only admin via console/internal
    }
  }
}
